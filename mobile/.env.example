# Copiar este archivo a .env.local y ajustar los valores
# Cada desarrollador debe configurar su propia IP local

# URL del API backend (reemplazar XXX con tu IP local)
# Para encontrar tu IP: ipconfig (Windows) o ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:4000/api

# Google Maps API Key (para mostrar mapas con seguimiento en tiempo real)
# Obtener una key en: https://console.cloud.google.com/apis/credentials
# Habilitar: Maps JavaScript API, Directions API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# URL del WebSocket (opcional, por defecto usa la misma IP que API_URL)
# EXPO_PUBLIC_WS_URL=ws://192.168.1.XXX:4000
