# ============================================
# SUBA Mobile - Variables de Entorno (Expo)
# ============================================
# Copia este archivo a .env y configura los valores
# cp .env.example .env
# ============================================

# ============================================
# API URL
# ============================================
# NOTA: En desarrollo, la app detecta automáticamente
# la IP del servidor Expo. Solo configura esto si:
# 1. Usas modo Tunnel
# 2. La detección automática falla
# 3. Estás en producción

# Desarrollo local (reemplaza con tu IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Producción:
# EXPO_PUBLIC_API_URL=https://api.suba.com

# ============================================
# Google Maps API Key (Opcional para desarrollo)
# ============================================
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-aqui
