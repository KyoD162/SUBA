{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
  "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*", "app/*"]
    }
  },
  "exclude": [
    "node_modules",
    "app",
    "web",
    "src/screens/main/RoutesScreen.tsx"
  ]
}
