{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "lib": ["ES2020", "DOM"],
    "target": "ES2020",
    "paths": {
      "@/*": ["src/*", "app/*"]
    },
    "types": ["react-native", "node"]
  },
  "exclude": [
    "node_modules",
    "app",
    "web",
    "src/screens/main/RoutesScreen.tsx"
  ]
}
