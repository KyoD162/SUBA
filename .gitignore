# =========================================
# SUBA - Git Ignore (Root Level)
# =========================================
# Este archivo cubre reglas globales.
# Los subdirectorios api/ y mobile/ tienen
# sus propios .gitignore para reglas específicas.
# =========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build outputs
**/dist/
**/build/
**/.expo/
**/.cache/

# Environment variables - CRÍTICO: nunca commitear
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# OS files
.DS_Store
Thumbs.db

# Expo/React Native
**/.expo-shared/
**/web-build/

# Code coverage
**/coverage/

# TypeScript
**/*.tsbuildinfo

# IDE/Editors
.vscode/
.idea/
.vs/
*.swp
*.swo

# Signing keys - CRÍTICO: nunca commitear
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.pem

# Logs
*.log
