# ============================================
# SUBA API - Variables de Entorno
# ============================================
# Copia este archivo a .env y configura los valores
# cp .env.example .env
# ============================================

# ============================================
# Base de Datos MongoDB
# ============================================
# Desarrollo local:
MONGO_URI=mongodb://localhost:27017/suba
# Con Docker Compose:
# MONGO_URI=mongodb://mongo:27017/suba
# MongoDB Atlas (producción):
# MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/suba

# ============================================
# JWT - Autenticación
# ============================================
# IMPORTANTE: Genera claves seguras con:
#   node generate-jwt-secrets.js
# O manualmente:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-too

# Tiempo de expiración de tokens
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# Servidor
# ============================================
PORT=4000
NODE_ENV=development

# CORS - Orígenes permitidos
# Desarrollo: usar * para permitir todos
# Producción: especificar dominios exactos
ORIGIN=*

# ============================================
# Rate Limiting (Opcional)
# ============================================
# Ventana de tiempo en milisegundos (15 minutos = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Requests máximos por ventana (general)
RATE_LIMIT_MAX_REQUESTS=100
# Requests máximos para auth (login/register)
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ============================================
# Desarrollo - Host para Expo
# ============================================
# Si usas Docker, Expo necesita saber la IP del host
# En Windows: usar ipconfig para obtener tu IP
# HOST_IP=192.168.1.100
