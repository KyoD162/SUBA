# =========================================
# SUBA Backend - Variables de Entorno
# =========================================
# Copia este archivo a .env y configura tus valores
# Genera claves JWT con: node generate-jwt-secrets.js
# =========================================

# -----------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------
NODE_ENV=development
PORT=4000

# -----------------------------------------
# CORS - Allowed Origins
# -----------------------------------------
# Para múltiples orígenes, separa con comas
# Ejemplo: http://localhost:19006,http://192.168.1.104:19006
# Para permitir todos (solo desarrollo): *
ORIGIN=http://localhost:19006

# -----------------------------------------
# DATABASE
# -----------------------------------------
# MongoDB Connection String
# Local: mongodb://localhost:27017/suba
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/suba
MONGO_URI=mongodb://localhost:27017/suba

# -----------------------------------------
# JWT SECRETS - ⚠️ CAMBIAR EN PRODUCCIÓN
# -----------------------------------------
# Genera con: node generate-jwt-secrets.js
# O con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# -----------------------------------------
# JWT EXPIRATION TIMES
# -----------------------------------------
# Formatos válidos: 60s, 5m, 1h, 7d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------
# RATE LIMITING
# -----------------------------------------
# Limiter General (toda la API)
RATE_LIMIT_WINDOW_MS=900000                # 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100                # Requests permitidos por ventana

# Limiter de Autenticación (login/register)
RATE_LIMIT_AUTH_WINDOW_MS=900000           # 15 minutos
RATE_LIMIT_AUTH_MAX_REQUESTS=5             # Intentos de login/registro

# Limiter de Refresh Token
RATE_LIMIT_REFRESH_WINDOW_MS=900000        # 15 minutos
RATE_LIMIT_REFRESH_MAX_REQUESTS=20         # Refreshes permitidos

# Limiter de Operaciones Sensibles
RATE_LIMIT_SENSITIVE_WINDOW_MS=3600000     # 1 hora
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=10       # Operaciones permitidas

# -----------------------------------------
# EMAIL CONFIGURATION (Opcional - futuro)
# -----------------------------------------
# Descomentar cuando implementes recuperación de contraseña
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@suba.com

# -----------------------------------------
# REDIS (Opcional - futuro)
# -----------------------------------------
# Para rate limiting distribuido en producción
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------
# LOGGING (Opcional - futuro)
# -----------------------------------------
# LOG_LEVEL=debug
# SENTRY_DSN=your-sentry-dsn
